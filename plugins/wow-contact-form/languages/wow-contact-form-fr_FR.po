#. Plugin Name of the plugin
#: wow-contact-form.php
msgid "WOW Contact Form"
msgstr ""

#. Description of the plugin
#: wow-contact-form.php
msgid "A contact form block: the visitor's message is kept in the site's own database and sent on by email, with no third-party service involved."
msgstr "Un bloc de formulaire de contact : le message du visiteur est conservé dans la base du site et transmis par e-mail, sans aucun service tiers."

#. Author of the plugin
#: wow-contact-form.php
msgid "Wow-arts"
msgstr ""

#: blocks/contact-form/render.php
msgid "Thank you — your message has reached us. We will get back to you shortly."
msgstr "Merci — votre message nous est bien parvenu. Nous vous répondrons rapidement."

#: blocks/contact-form/render.php
msgid "Leave this field empty"
msgstr "Laissez ce champ vide"

#: blocks/contact-form/render.php
msgid "Send"
msgstr "Envoyer"

#: includes/admin.php
msgid "From"
msgstr "Expéditeur"

#: includes/admin.php
msgid "Email"
msgstr "E-mail"

#: includes/admin.php
#: includes/storage.php
msgid "Message"
msgstr "Message"

#: includes/admin.php
msgid "Notification"
msgstr "Notification"

#: includes/admin.php
msgid "Received"
msgstr "Reçu le"

#: includes/admin.php
msgid "Sent"
msgstr "Envoyée"

#: includes/admin.php
msgid "Not sent"
msgstr "Non envoyée"

#: includes/block.php
msgid "WOW"
msgstr ""

#: includes/fields.php
msgctxt "form field"
msgid "First name"
msgstr "Votre Prénom"

#: includes/fields.php
msgctxt "form field"
msgid "Last name"
msgstr "Votre Nom"

#: includes/fields.php
msgctxt "form field"
msgid "Company"
msgstr "Votre Entreprise"

#: includes/fields.php
msgctxt "form field"
msgid "Email"
msgstr "Votre Email"

#: includes/fields.php
msgctxt "form field"
msgid "Message"
msgstr "Votre Message"

#. translators: %s: field label.
#: includes/fields.php
#, php-format
msgid "%s is required."
msgstr "Le champ « %s » est obligatoire."

#: includes/fields.php
msgid "That does not look like an email address."
msgstr "Cela ne ressemble pas à une adresse e-mail."

#. translators: 1: site name, 2: sender's name.
#: includes/mail.php
#, php-format
msgid "[%1$s] Message from %2$s"
msgstr "[%1$s] Message de %2$s"

#: includes/mail.php
msgid "Read it in the site admin:"
msgstr "Le lire dans l’administration du site :"

#: includes/mail.php
msgid "No valid recipient address is configured."
msgstr "Aucune adresse de destinataire valide n’est configurée."

#: includes/mail.php
msgid "Sending was stopped before it began."
msgstr "L’envoi a été interrompu avant même de commencer."

#: includes/patterns.php
msgid "Contact page"
msgstr "Page de contact"

#: includes/patterns.php
msgid "A short introduction and the contact form beneath it."
msgstr "Une courte introduction et le formulaire de contact en dessous."

#: includes/storage.php
msgctxt "post type general name"
msgid "Messages"
msgstr "Messages"

#: includes/storage.php
msgctxt "post type singular name"
msgid "Message"
msgstr "Message"

#: includes/storage.php
msgctxt "admin menu"
msgid "Messages"
msgstr "Messages"

#: includes/storage.php
msgid "All Messages"
msgstr "Tous les messages"

#: includes/storage.php
msgid "View Message"
msgstr "Voir le message"

#: includes/storage.php
msgid "Search Messages"
msgstr "Rechercher des messages"

#: includes/storage.php
msgid "No messages yet"
msgstr "Aucun message pour l’instant"

#: includes/storage.php
msgid "No messages in the bin"
msgstr "Aucun message dans la corbeille"

#. translators: 1: sender's name, 2: company name.
#: includes/storage.php
#, php-format
msgctxt "message title"
msgid "%1$s (%2$s)"
msgstr "%1$s (%2$s)"

#: includes/submission.php
msgid "You have just sent a message. Please give it a moment before sending another."
msgstr "Vous venez d’envoyer un message. Patientez un instant avant d’en envoyer un autre."

#: includes/submission.php
msgid "This page had been open for a while and the form expired. Nothing was lost — please send it again."
msgstr "Cette page est restée ouverte trop longtemps et le formulaire a expiré. Rien n’est perdu — merci de l’envoyer à nouveau."

#: includes/submission.php
msgid "The message was not sent. Please look at the fields marked below."
msgstr "Le message n’a pas été envoyé. Merci de vérifier les champs signalés ci-dessous."

#: includes/submission.php
msgid "Something went wrong on our side and the message was not saved. Please try again in a moment."
msgstr "Un problème est survenu de notre côté et le message n’a pas été enregistré. Merci de réessayer dans un instant."

#: patterns/contact-page.php
msgid "Write to us using the form below and we will answer as soon as we can."
msgstr "Écrivez-nous via le formulaire ci-dessous, nous vous répondrons dès que possible."

#: blocks/contact-form/block.json
msgctxt "block title"
msgid "Contact form"
msgstr "Formulaire de contact"

#: blocks/contact-form/block.json
msgctxt "block description"
msgid "A form the visitor writes to you with. Messages are kept on the site and sent on by email."
msgstr "Un formulaire par lequel le visiteur vous écrit. Les messages sont conservés sur le site et transmis par e-mail."
