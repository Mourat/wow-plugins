#. Plugin Name of the plugin
#: wow-blocks.php
msgid "WOW Blocks"
msgstr ""

#. Description of the plugin
#: wow-blocks.php
msgid "Fixed-grid gallery rows: one, two or three columns, each holding an image or a solid colour fill, plus a narrow divider strip."
msgstr "Rangées de galerie à grille fixe : une, deux ou trois colonnes, contenant chacune une image ou un aplat de couleur, plus une bande de séparation étroite."

