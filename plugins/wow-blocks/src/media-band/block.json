{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wow/media-band",
	"version": "0.1.0",
	"title": "WOW: Narrow strip",
	"category": "wow",
	"icon": "minus",
	"description": "A low divider strip: a solid colour fill with an image on the left or the right.",
	"keywords": [ "wow", "divider", "strip" ],
	"textdomain": "wow-blocks",
	"attributes": {
		"backgroundColor": {
			"type": "string",
			"default": ""
		},
		"imagePosition": {
			"type": "string",
			"default": "left"
		},
		"imageWidth": {
			"type": "number"
		},
		"imageScale": {
			"type": "number",
			"default": 1
		},
		"image": {
			"type": "object",
			"default": {
				"id": 0,
				"url": "",
				"alt": "",
				"focalPoint": {
					"x": 0.5,
					"y": 0.5
				}
			}
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": false,
		"spacing": {
			"margin": [ "top", "bottom" ]
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
